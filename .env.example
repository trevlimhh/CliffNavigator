# Free at aistudio.google.com/apikey — no card needed. Powers both the intake extraction and
# explanation calls (see src/services/geminiClient.ts). The app gracefully falls back to a
# non-AI demo mode if this is unset — see src/lib/mockAiResponses.ts.
GEMINI_API_KEY=

# Supabase (Project Settings -> API). Auth + persistence stop working without these — the app
# gracefully falls back to the no-login /demo page until they're set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — bypasses Row Level Security. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com -> API Keys). Optional: without it, notifications still work in-app,
# emails are just skipped (logged instead) — see src/lib/email.ts.
RESEND_API_KEY=

# Shared secret the scheduled notification check (src/app/api/notifications/check) requires in
# an `x-cron-secret` header. Make up any long random string; put the same value in the Supabase
# Edge Function's secrets (see supabase/functions/check-notifications/index.ts).
CRON_SECRET=

# Used only by the Supabase Edge Function to call back into this app — set this to your deployed
# app's URL (e.g. https://your-app.vercel.app) once it's live. Not needed for local dev.
APP_URL=

# Web Push (browser push notifications). Optional: without these, push notifications are skipped
# (logged instead) — see src/lib/sendPush.ts. Generate a keypair with:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Any contact URI — shown to push services if they need to reach you about your usage.
VAPID_SUBJECT=mailto:you@example.com
